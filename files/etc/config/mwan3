config globals 'globals'
	option mmx_mask '0x3F00'

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	option reliability '2'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option flush_conntrack 'disconnected'
	option gateway '10.22.128.1'

config interface 'wanb'
	option enabled '1'
	option family 'ipv4'
	option reliability '2'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option flush_conntrack 'disconnected'

config interface 'wan_6'
	option enabled '1'
	option family 'ipv6'
	option reliability '0'
	option count '1'
	option timeout '2'
	option interval '10'
	list track_ip '2400:3200::1'

config interface 'wanb_6'
	option enabled '1'
	option family 'ipv6'
	option reliability '0'
	option count '1'
	option timeout '2'
	option interval '10'
	list track_ip '2400:3200::1'

config member 'wan_v4'
	option interface 'wan'
	option metric '1'
	option weight '1'

config member 'wanb_v4'
	option interface 'wanb'
	option metric '1'
	option weight '1'

config member 'wan_v6'
	option interface 'wan_6'
	option metric '1'
	option weight '1'

config member 'wanb_v6'
	option interface 'wanb_6'
	option metric '1'
	option weight '1'

config policy 'balanced'
	list use_member 'wan_v4'
	list use_member 'wanb_v4'
	list use_member 'wan_v6'
	list use_member 'wanb_v6'
	option last_resort 'unreachable'

config policy 'wan_only'
	list use_member 'wan_v4'
	list use_member 'wan_v6'
	option last_resort 'unreachable'

config policy 'wanb_only'
	list use_member 'wanb_v4'
	list use_member 'wanb_v6'
	option last_resort 'unreachable'

config rule 'https'
	option dest_port '443'
	option proto 'tcp'
	option use_policy 'balanced'

config rule 'default_v4'
	option dest_ip '0.0.0.0/0'
	option family 'ipv4'
	option use_policy 'balanced'

config rule 'default_v6'
	option dest_ip '::/0'
	option family 'ipv6'
	option use_policy 'balanced'
